#!/bin/sh
set -eu

period=${1:-today}
case "$period" in
  today|week) ;;
  -h|--help)
    echo "usage: pi-standup [today|week]"
    exit 0
    ;;
  *)
    echo "usage: pi-standup [today|week]" >&2
    exit 2
    ;;
esac

prompt=$(cat <<'EOF'
Produce a fast, confident work summary. Read only; do not edit files or modify Jira.

1. Compute the requested local-time window: "today" starts at local midnight; "week" starts Monday at local midnight.
2. Read Pi chat session JSONL files under ~/.pi/agent/sessions whose messages overlap that window. Use only main-session user and final assistant messages; skip tool results, thinking, and subagent transcripts.
3. From the repositories/directories identified by those chats, read only report-like files modified in the window (names containing report, weekly, daily, standup, summary, or handoff). Cap this at the 20 most recent files.
4. Do not inspect Git history, diffs, or source code. Do not contact live sessions.
5. Extract explicit Jira keys and obvious task topics from the chats/reports. Use Jira MCP only to verify those tickets or make a strong assignee-scoped match for Valdy Lionel Christian. Do not invent associations.
6. Group the result by repository. Emit 3-4 factual update bullets per repository, unless the evidence clearly contains several distinct substantial tasks. Include Jira keys inline. Add one short blockers/next-steps section only when supported by the evidence.

Be terse. State completed versus in-progress plainly. Omit evidence dumps, process narration, empty sections, and generic caveats.
EOF
)

exec pi -p --no-session --thinking low -- "$prompt

Requested period: $period"
