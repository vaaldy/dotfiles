// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            //If you want to overwrite your keyboard layout,
            // uncomment the line below and change the layout accordingly.
            //layout "us" // Use the American keyboard layout
        }
        numlock // Enable numlock on startup
    }

    // No touchpad on this machine. Of the two settings the laptop's touchpad block
    // carried, only one has a desktop counterpart:
    //   tap            -> nothing to port, the mouse has real buttons
    //   natural-scroll -> below, deliberately left off
    // Nothing to port for gestures either: workspace switching is on keybinds
    // (Mod+1-9, Mod+Tab, Mod+WheelScrollUp/Down), never was on touchpad swipes.
    mouse {
        // natural-scroll inverts the wheel to match the macOS trackpad feel. It also
        // flips niri's WheelScrollUp/Down binds, so Mod+wheel workspace switching
        // reverses with it — enable both or neither.
        //natural-scroll

        // Pointer acceleration OFF. "flat" means output is a constant multiple of
        // the mouse's own counts — no speed-dependent curve, so a fast flick and a
        // slow drag of the same physical distance move the cursor equally far.
        // The alternative is "adaptive" (libinput's default, accelerated).
        accel-profile "flat"

        // Sensitivity, range -1.0 to 1.0. Under the flat profile this is a plain
        // linear multiplier: 0.0 is 1:1 with the sensor, negative is slower,
        // positive is faster. Tune this, not the mouse's DPI — DPI lives in the
        // mouse's own firmware and libratbag/Piper can't reach a Compx VXE.
        accel-speed 0.0
    }

    focus-follows-mouse // Automatically focus windows under the mouse pointer
    workspace-auto-back-and-forth // Enable workspace back & forth switching
}
