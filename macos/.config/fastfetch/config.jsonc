// ~/.config/fastfetch/config.jsonc
//
// The ASCII-art-and-specs header you get once per fresh Alacritty window —
// wired up in install.sh's .zshrc block, gated so it fires only OUTSIDE
// tmux (i.e. once when the terminal opens, not on every one of agentproj's
// four panes). Colors match the Tokyo Night Storm theme used everywhere
// else in this stack (alacritty.toml, tmux.conf).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",           // Apple logo on macOS, distro logo on Linux — no need to hardcode
    "padding": { "top": 1, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "34", "title": "39" }   // ANSI blue for keys/title, close to #7aa2f7
  },
  "modules": [
    { "type": "title", "color": { "user": "35", "at": "37", "host": "35" } },
    "separator",
    { "type": "os",       "key": " OS" },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "uptime",   "key": "󰅐 Uptime" },
    { "type": "packages", "key": "󰏖 Packages" },
    { "type": "shell",    "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "wm",       "key": "󰖲 WM", "format": "{pretty-name}" },
    "break",
    { "type": "cpu",      "key": "󰻠 CPU" },
    { "type": "gpu",      "key": "󰢮 GPU" },
    { "type": "memory",   "key": "󰍛 Memory" },
    { "type": "disk",     "key": "󰋊 Disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
