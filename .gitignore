# machine-generated / host-specific state
fish_variables
alacritty/.config/alacritty/themes/noctalia.toml
*.bak
*.swp

# local project prompts (independently tracked)
/prompts/

# editor + plugin state (lazy-lock.json is tracked on purpose)
nvim/.config/nvim/lazy/
nvim/.config/nvim/plugin/

# credentials and local environment
.env
.env.*
*.env
*.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Pi credentials and runtime state
pi/.pi/agent/auth.json
pi/.pi/agent/models-store.json
# ccmux-managed pi extension, rewritten by `ccmux setup`
pi/.pi/agent/extensions/ccmux.js
pi/.pi/agent/npm/
pi/.pi/agent/sessions/
