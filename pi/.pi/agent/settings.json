{
  "lastChangelogVersion": "1.4.0",
  "theme": "tokyo-night",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-terra",
  "enabledModels": [
    "openai-codex/gpt-*",
    "openrouter/openai/gpt-*",
    "openrouter/google/*",
    "opencode-go/claude-haiku-5-5",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/qwen3.8-flash",
    "opencode-go/qwen3.8-max"
  ],
  "packages": [
    "npm:pi-mcp-adapter@2.33.0",
    "git:github.com/avhagedorn/pi-compact-transcript",
    "~/.pi/agent/local-packages/pi-nunc",
    "npm:pi-studio",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-intercom",
    "npm:pi-annotate",
    {
      "source": "npm:pi-jev",
      "extensions": []
    }
  ],
  "subagents": {
    "defaultModel": "opencode-go/claude-haiku-5-5",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "high",
        "defaultContext": "fresh"
      }
    }
  },
  "hideThinkingBlock": true,
  "outputPad": 0
}