{
  "lastChangelogVersion": "1.5.0",
  "theme": "tokyo-night",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-terra",
  "enabledModels": [
    "openai-codex/gpt-*",
    "openrouter/openai/gpt-*",
    "openrouter/google/*",
    "opencode-go/claude-haiku-5-5",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/qwen3.8-flash",
    "opencode-go/qwen3.8-max"
  ],
  "packages": [
    "npm:pi-mcp-adapter@2.33.0",
    "git:github.com/avhagedorn/pi-compact-transcript",
    "~/.pi/agent/local-packages/pi-nunc",
    "npm:pi-studio",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-intercom",
    "npm:pi-annotate",
    {
      "source": "npm:pi-jev",
      "extensions": []
    }
  ],
  "npmCommand": [
    "npm",
    "--allow-remote=all"
  ],
  "nunc": {
    "memoryTools": true
  },
  "compaction": {
    "modelOverrides": {
      "openai-codex/gpt-6.1-sol": {
        "reserveTokens": 650000
      },
      "openai-codex/gpt-6.1-terra": {
        "reserveTokens": 650000
      }
    }
  },
  "subagents": {
    "defaultModel": "opencode-go/claude-haiku-5-5",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6.1-terra",
        "thinking": "high",
        "defaultContext": "fresh"
      }
    }
  },
  "hideThinkingBlock": true,
  "outputPad": 0,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter@2.33.0\",\"scope\":\"user\"}": "2.33.0",
    "{\"source\":\"npm:pi-smart-compact\",\"scope\":\"user\"}": "10.7.3",
    "{\"source\":\"npm:pi-studio\",\"scope\":\"user\"}": "0.11.8",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0",
    "{\"source\":\"npm:pi-annotate\",\"scope\":\"user\"}": "0.5.2",
    "{\"source\":\"npm:pi-jev\",\"scope\":\"user\"}": "0.8.0"
  }
}