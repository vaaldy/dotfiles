{
  "lastChangelogVersion": "0.85.1",
  "theme": "tokyo-night",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "enabledModels": [
    "openai-codex/gpt-*",
    "openrouter/openai/gpt-*",
    "openrouter/google/*",
    "opencode-go/deepseek-v4.1-flash"
  ],
  "packages": [
    "npm:pi-mcp-adapter@2.33.0",
    "git:github.com/avhagedorn/pi-compact-transcript",
    "npm:pi-smart-compact",
    "npm:pi-studio",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-intercom",
    "npm:pi-annotate",
    "npm:pi-jev"
  ],
  "subagents": {
    "defaultModel": "opencode-go/deepseek-v4.1-flash",
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "evidence-auditor": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high",
        "defaultContext": "fresh"
      }
    }
  },
  "hideThinkingBlock": true,
  "outputPad": 0
}